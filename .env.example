# Groq API key: https://console.groq.com/keys (free, no card)
GROQ_API_KEY=

# 32+ random characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Postgres (Neon). Optional locally: without it the game uses an in-memory
# store. Required on Vercel, where the Neon integration sets it for you.
DATABASE_URL=

# Optional tuning. The defaults are shown.
# GAME_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# GUARD_THRESHOLD=0.5
# DAILY_ATTEMPT_CAP=1800
# IP_HOURLY_LIMIT=40
# GAME_ENABLED=true
